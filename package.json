{
  "name": "app-gym",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "yarn workspace @gym/api dev",
    "dev:admin": "yarn workspace @gym/admin dev",
    "build:api": "yarn workspace @gym/api build",
    "build:admin": "yarn workspace @gym/admin build",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma",
    "db:seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "prisma": "^5.10.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0"
  }
}
